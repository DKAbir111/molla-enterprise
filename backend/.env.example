# Backend environment. Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. This example is committed — never put real secrets here.

# --- Required --------------------------------------------------------------

# Postgres connection. DIRECT_URL is used by `prisma migrate`; with a local
# database it can be the same as DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/molla?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/molla?schema=public"

# Signs JWTs (7d expiry). Unset falls back to "change-me" — always set this
# when deployed. Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me"

# Frontend origin, allowed by CORS and used to build password-reset links.
FRONTEND_ORIGIN="http://localhost:3000"

# --- Optional --------------------------------------------------------------

# Dev port (ignored on Vercel). Default: 4000
PORT=4000

# Public URL of THIS backend, used to turn stored upload paths into absolute
# URLs in API responses. Default: http://localhost:4000
PUBLIC_BASE_URL="http://localhost:4000"

# Email / SMTP. Needed for password-reset and low-stock alert emails. Leave
# unset to disable email — the app logs a warning and keeps working.
# Port 465 = implicit TLS; anything else = STARTTLS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="you@example.com"
SMTP_PASS=""
SMTP_FROM="Molla Enterprise <no-reply@example.com>"
