# ---------------------------------------------------------------------------
# Backend (NestJS + Prisma) environment variables
#
# Copy this file to `.env` and fill in the real values:
#   cp .env.example .env
#
# `.env` is git-ignored; this example file is committed on purpose, so never
# put real secrets, passwords, or production URLs in here.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Postgres connection string used by Prisma at runtime.
# If you use a pooled provider (Supabase/Neon/PgBouncer), this is the POOLED url.
DATABASE_URL="postgresql://user:password@localhost:5432/molla?schema=public"

# Direct (non-pooled) connection, used for `prisma migrate`.
# With a local Postgres you can set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/molla?schema=public"

# --- Server ----------------------------------------------------------------
# Port for local dev (`npm run dev`). Ignored on Vercel. Default: 4000
PORT=4000

# --- Auth (required) -------------------------------------------------------
# Secret used to sign JWTs. Tokens are issued with a 7d expiry.
# The code falls back to the literal string "change-me" if this is unset,
# which lets anyone forge a valid token — always set this in any deployed env.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me"

# --- URLs / CORS -----------------------------------------------------------
# Origin allowed by CORS in production, and the base used to build password
# reset links in emails. Must be the exact scheme+host of the frontend,
# with no trailing path.
FRONTEND_ORIGIN="http://localhost:3000"

# Public URL of the frontend app. Used as the CORS fallback when
# FRONTEND_ORIGIN is unset, and to build reset links (`<APP_PUBLIC_URL>/en/reset-password?token=...`).
# Default: http://localhost:3000
APP_PUBLIC_URL="http://localhost:3000"

# Public base URL of THIS api, used to turn stored upload paths
# (e.g. /uploads/products/product-123.png) into absolute URLs in API responses.
# API_PUBLIC_BASE is only read as a fallback when PUBLIC_BASE_URL is unset.
# Default: http://localhost:4000
PUBLIC_BASE_URL="http://localhost:4000"
API_PUBLIC_BASE="http://localhost:4000"

# --- Email / SMTP (optional) -----------------------------------------------
# Used for password-reset emails and low-stock alert digests.
# If SMTP_HOST, SMTP_USER, or SMTP_PASS is missing, the app logs
# "SMTP configuration missing; emails will not be sent" and silently skips
# sending — everything else keeps working.
SMTP_HOST="smtp.gmail.com"
# 587 = STARTTLS (default), 465 = implicit TLS
SMTP_PORT=587
SMTP_USER="you@example.com"
SMTP_PASS=""
# "true" forces implicit TLS. Port 465 already implies it. Default: false
SMTP_SECURE=false
# From address on outgoing mail. Default: no-reply@localhost
SMTP_FROM="Molla Enterprise <no-reply@example.com>"
# "true" disables TLS certificate validation — local/self-signed testing ONLY,
# never in production. Default: false
SMTP_ALLOW_INVALID_CERTS=false
# "true" enables verbose nodemailer logging. Default: false
SMTP_DEBUG=false

# --- Tuning (optional) -----------------------------------------------------
# In-memory TTL for the organization lookup cache, in ms. Default: 60000
ORG_CACHE_TTL_MS=60000

# Cron expression for the daily alert email digest.
# Default: 0 0 9 * * *  (every day at 09:00 server time)
ALERTS_DIGEST_CRON="0 0 9 * * *"
